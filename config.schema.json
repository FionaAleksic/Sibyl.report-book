{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "minimumEntryMinutes": {
      "type": "integer",
      "enum": [
        15,
        30,
        60
      ],
      "default": 15
    },
    "allowMarkdownExport": {
      "type": "boolean",
      "default": true
    },
    "weeklyTargetMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10080,
      "default": 2400
    }
  }
}
